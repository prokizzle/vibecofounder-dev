# Resend (email delivery for lead magnet)
# Get your API key at https://resend.com/api-keys
# Must verify your domain first at https://resend.com/domains
RESEND_API_KEY=

# Resend webhook signing secret (from https://resend.com/webhooks)
RESEND_WEBHOOK_SECRET=

# Sentry (error tracking)
# Create a Next.js project at https://sentry.io → Settings → Projects → New Project
# The DSN is found in Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# Sentry org and project slugs (for source maps upload during build)
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry auth token (for source maps upload — generate at https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=

# HubSpot CRM (lead tracking)
# Create a Private App token at https://app.hubspot.com/developer > Legacy apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# HubSpot webhook verification (Client Secret from your private app's Auth tab)
# Needed only if you configure HubSpot webhooks pointing to /api/webhooks/hubspot
HUBSPOT_CLIENT_SECRET=
